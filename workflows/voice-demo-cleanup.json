{
  "name": "voice-demo-cleanup",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 15 }] }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [0, 0],
      "id": "317a2875-e1e2-4c28-921d-3f4df63fc6d4",
      "name": "Every 15 minutes"
    },
    {
      "parameters": {
        "resource": "event",
        "operation": "getAll",
        "calendar": { "__rl": true, "mode": "id", "value": "YOUR_DEMO_CALENDAR_ID" },
        "returnAll": true,
        "timeMin": "={{ $now.minus({ days: 30 }).toISO() }}",
        "timeMax": "={{ $now.plus({ days: 365 }).toISO() }}",
        "options": { "recurringEventHandling": "expand" }
      },
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [224, 0],
      "id": "a65aaeec-2556-4a5e-b888-aa8b4f29e8d6",
      "name": "Get demo events",
      "credentials": {
        "googleCalendarOAuth2Api": { "id": "", "name": "Google Calendar account" }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cutoff = Date.now() - 60 * 60 * 1000;\nreturn $input.all()\n  .filter((item) => item.json.id && item.json.created && new Date(item.json.created).getTime() < cutoff)\n  .map((item) => ({ json: { id: item.json.id } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [448, 0],
      "id": "85ad52d3-fe36-414f-a495-ae81ffe8b5c7",
      "name": "Keep bookings older than 60 min"
    },
    {
      "parameters": {
        "resource": "event",
        "operation": "delete",
        "calendar": { "__rl": true, "mode": "id", "value": "YOUR_DEMO_CALENDAR_ID" },
        "eventId": "={{ $json.id }}",
        "options": { "sendUpdates": "none" }
      },
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [672, 0],
      "id": "b91fa658-24b1-4c2d-b071-c01eee37fbbe",
      "name": "Delete demo event",
      "credentials": {
        "googleCalendarOAuth2Api": { "id": "", "name": "Google Calendar account" }
      }
    }
  ],
  "connections": {
    "Every 15 minutes": { "main": [[{ "node": "Get demo events", "type": "main", "index": 0 }]] },
    "Get demo events": { "main": [[{ "node": "Keep bookings older than 60 min", "type": "main", "index": 0 }]] },
    "Keep bookings older than 60 min": { "main": [[{ "node": "Delete demo event", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
