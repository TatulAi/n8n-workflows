    {
      "parameters": {
        "jsCode": "const DURATIONS = { haircut: 30, beard_trim: 20, combo: 45 };\nconst { date, time, service, customer_name } = $('Edit Fields').first().json;\n\nconst duration = DURATIONS[service];\nif (!duration) {\n  return [{ json: { ok: false, reason: 'unknown_service' } }];\n}\nif (!/^\\d{2}:\\d{2}$/.test(time) || !customer_name) {\n  return [{ json: { ok: false, reason: 'invalid_input' } }];\n}\nif (new Date(`${date}T12:00:00`).getDay() === 0) {\n  return [{ json: { ok: false, reason: 'closed_sunday' } }];\n}\n\nconst [h, m] = time.split(':').map(Number);\nconst startMin = h * 60 + m;\nconst endMin = startMin + duration;\nif (startMin < 9 * 60 || endMin > 18 * 60) {\n  return [{ json: { ok: false, reason: 'outside_hours' } }];\n}\n\nconst fmt = new Intl.DateTimeFormat('en-GB', {\n  timeZone: 'Europe/Bratislava', hour: '2-digit', minute: '2-digit', hour12: false,\n});\nconst toMin = (iso) => {\n  const [hh, mm] = fmt.format(new Date(iso)).split(':').map(Number);\n  return hh * 60 + mm;\n};\n\nconst busy = $input.all().map(i => i.json)\n  .filter(e => e.start?.dateTime && e.end?.dateTime)\n  .map(e => ({ start: toMin(e.start.dateTime), end: toMin(e.end.dateTime) }));\n\nif (busy.some(b => startMin < b.end && endMin > b.start)) {\n  return [{ json: { ok: false, reason: 'slot_taken' } }];\n}\n\nconst pad = (n) => String(n).padStart(2, '0');\nconst endTime = `${pad(Math.floor(endMin / 60))}:${pad(endMin % 60)}`;\n\nreturn [{ json: {\n  ok: true, date, time, service, customer_name,\n  start: `${date}T${time}:00`,\n  end: `${date}T${endTime}:00`,\n  end_time: endTime,\n} }];"
      },
      "type": "n8n-nodes-base.code",
